    "graph": "depcruise --no-config --ts-config tsconfig.json --focus",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.6",
    "axios": "^1.9.0",
